import "org.stardustxr.Spatial" as spatial
import "org.stardustxr.Field" as field
import "org.stardustxr.Types" as types

/// Chirality
enum Chirality {
	Left,
	Right,
}

/// A hand joint. Distance from input handler's field is given because it's cheap to calculate and laggy to request from the server.
struct Joint {
	/// Pose of the joint relative to the input handler.
	pose: types::Posef,
	/// Radius of the joint in meters.
	radius: f32,
	/// Distance from the center of the joint to the input handler's field.
	distance: f32,
}

/// Finger
struct Finger {
	tip: Joint,
	distal: Joint,
	intermediate: Joint,
	proximal: Joint,
	metacarpal: Joint,
}

/// Different than finger to be explicit about number of joints.
struct Thumb {
	tip: Joint,
	distal: Joint,
	proximal: Joint,
	metacarpal: Joint,
}

/// A fully articulated and tracked hand (https://registry.khronos.org/OpenXR/specs/1.1/html/xrspec.html#convention-of-hand-joints).
struct Hand {
	chirality: Chirality,

	thumb: Thumb,
	index: Finger,
	middle: Finger,
	ring: Finger,
	little: Finger,
	palm: Joint,
	wrist: Joint,
	elbow: Option<Joint>,
}

/// A 3D pointer, such as a gaze pointer for eye tracking or a mouse or a ray from a controller.
struct Pointer {
	/// Often corresponds to the aim pose (https://registry.khronos.org/OpenXR/specs/1.1/html/xrspec.html#semantic-paths-standard-pose-identifiers)
	pose: types::Posef,
	/// The point that is the most inside the input handler's field.
	/// Useful for telling how close to the center it's pointing or for thin objects can take the place of a point of intersection.
	deepest_point: f32,
}

/// Represents a controller, pen tip, spatial cursor, etc. that is just a single point.
struct Tip {
	/// Pose you can use to tap/poke elements (in front of the face of a controller, or on a pen tip).
	pose: types::Posef,
	/// Is this tip in the left or right hand? This may change at any time.
	chirality: Option<Chirality>,
	/// Center of the controller treated as a gripped rod (https://registry.khronos.org/OpenXR/specs/1.1/html/xrspec.html#semantic-paths-standard-pose-identifiers)
	grip_pose: Option<types::Posef>,
	/// Center of the palm contacting the controller (https://registry.khronos.org/OpenXR/specs/1.1/html/xrspec.html#semantic-paths-standard-pose-identifiers)
	grip_surface_pose: Option<types::Posef>,
	/// Non-articulated hand data (for index or similar)
	simulated_hand: Option<Hand>,
}

/// The special type of an InputMethod.
enum InputDataType {
	Pointer { data: Pointer },
	Hand { data: Hand },
	Tip { data: Tip },
}

/// Data types for datamap
enum DatamapData {
	Bool { value: bool },
	Float { value: f32 },
	Vec2 { value: types::Vec2f },
	Vec3 { value: types::Vec3f },
	String { value: String },
}

/// Information about a given input method's state.
struct SemanticData {
	/// Non-spatial data in a map. Keys will be a superset of the keys returned by InputHandler::suggested_bindings
	datamap: Map<String, DatamapData>,
	/// There are [order] objects that got this input data before this one.
	order: u32,
	/// Is this input handler capturing this input method?
	captured: bool,
}

/// Information about a given input method's spatial state. All coordinates are relative to the InputHandlers SpatialRef.
struct SpatialData {
	/// All vectors and quaternions are relative to the input handler spatial ref.
	input: InputDataType,
	/// Closest distance from the input method to the field.
	distance: f32,
}

/// Receives input from input methods.
interface InputHandler {
	/// All input coordinates will be relative to this
	/// This is considered static and should not change after handler creation.
	get_spatial() -> (spatial: Ref<spatial::SpatialRef>)
	/// This is considered static and should not change after handler creation.
	get_field() -> (field: Ref<field::FieldRef>)

	/// An input method just started sending input to this handler.
	input_gained(method: Ref<InputMethod>, time: types::Timestamp, spatial: SpatialData, semantic: SemanticData)
	/// An input method's data has been updated.
	input_updated(method: Ref<InputMethod>, time: types::Timestamp, spatial: SpatialData, semantic: SemanticData)
	/// An input method just stopped sending input to this handler.
	input_left(method: Ref<InputMethod>, time: types::Timestamp)
}

/// Node representing a spatial input device.
///
/// Each input method is different, and has heuristics that apply to the specific device that drives it.
/// For example, a mouse is a perfectly stable pointer that slides in 2D space, so picking the first thing it hits makes sense.
/// On the other hand, a pointer attached to a controller is inherently shaky and so giving it some fuzzier heuristics (such as sending input to near misses by angle) helps make input more reliable.
///
/// So because of that, the true state of the input method is updated whenever the device gets an event.
///
/// The handler order is updated for 2 reasons:
/// 1. Send input to every handler that the user might reasonably be trying to interact with.
/// 2. The order lets the handler show the user how likely it is to be picked (via signifiers), so the user can adjust their input device.
///
/// The capture system is a collaborative effort between the input method and the handler to make sure that:
/// 1. The input method decides what recieves input, for security and reliability (if the client with an input handler freezes, it won't lock up the entire input method).
/// 2. The handler can request temporary exclusive access to the input method, to prevent input collisions (if I'm grabbing something, i don't want anything else to interfere or assume it is being grabbed with a pinch gesture).
/// 3. The heuristics of the input method and handler are both considered (e.g. the input method for a hand might send input only to nearby handlers, but then the handler requests a capture when it is pinched. This would make a handler with a field intersecing another that does not use pinch differentiated, and therefore improves reliability.).
interface InputMethod {
	/// Request to capture the input method with the given handler.
	request_capture(handler: Ref<InputHandler>) -> (capture: Option<InputMethodCapture>)
	/// Get spatial data relative to the input handler at a specific point in time.
	/// Should return None when the InputMethod is captured by another InputHandler.
	get_spatial_data(handler: Ref<InputHandler>, time: types::Timestamp) -> (data: Option<SpatialData>)
}

/// An active input method capture, drop to release the capture (e.g. the object is let go of after grabbing).
/// Will be invalidated if the input method sends input_left
interface InputMethodCapture {}
