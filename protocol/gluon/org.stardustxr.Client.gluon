import "org.stardustxr.Types" as types

/// Information for a specific frame
struct FrameInfo {
	delta: f32,
	predicted_display_time: types::Timestamp,
}

// The hub of the client. Spatially this is positioned where the client is started so is a stable base to position things relative to.
/// Client
interface Client {
	ping() -> ()

	frame(info: FrameInfo)
}
