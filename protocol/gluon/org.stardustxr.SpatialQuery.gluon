import "org.stardustxr.Spatial" as spatial
import "org.stardustxr.Field" as field
import "org.stardustxr.Types" as types
import "org.stardustxr.Query" as query


/// shoot a beam and return everything it hit
struct BeamQuery {
  handler: Ref<BeamQueryHandler>,
  interfaces: Vec<query::InterfaceDependency>,

  reference_spatial: Ref<spatial::SpatialRef>,
  origin: types::Vec3f,
  direction: types::Vec3f,
  /// Maximum length of the beam in meters, can be the max f32 value
  max_length: f32,
}

/// handle the beam query
interface BeamQueryHandler {
  intersected(obj: Ref<query::QueryableObjectRef>, field: Ref<field::FieldRef>, spatial: Ref<spatial::SpatialRef>, interfaces: Vec<query::QueriedInterface>, spatial_info: field::RayMarchResult)
  interfaces_changed(obj: Ref<query::QueryableObjectRef>, interfaces: Vec<query::QueriedInterface>)
  moved(obj: Ref<query::QueryableObjectRef>, spatial_info: field::RayMarchResult)
  left(obj: Ref<query::QueryableObjectRef>)
}

/// Get interfaces intersecting this field
struct ZoneQuery {
  handler: Ref<ZoneQueryHandler>,
  interfaces: Vec<query::InterfaceDependency>,

  zone_field: Ref<field::FieldRef>,
  margin: f32,
}

/// handle the zone query
interface ZoneQueryHandler {
  entered(obj: Ref<query::QueryableObjectRef>, field: Ref<field::FieldRef>, spatial: Ref<spatial::SpatialRef>, interfaces: Vec<query::QueriedInterface>, relative_position: types::Vec3f, spatial_info: field::FieldSample)
  interfaces_changed(obj: Ref<query::QueryableObjectRef>, interfaces: Vec<query::QueriedInterface>)
  moved(obj: Ref<query::QueryableObjectRef>, relative_position: types::Vec3f, spatial_info: field::FieldSample)
  left(obj: Ref<query::QueryableObjectRef>)
}

/// Get interfaces of fields containing any points
struct PointsQuery {
  handler: Ref<PointsQueryHandler>,
  interfaces: Vec<query::InterfaceDependency>,
  reference_spatial: Ref<spatial::SpatialRef>,
  points: Vec<Point>
}

/// handle the points query
interface PointsQueryHandler {
  entered(obj: Ref<query::QueryableObjectRef>, field: Ref<field::FieldRef>, spatial: Ref<spatial::SpatialRef>, interfaces: Vec<query::QueriedInterface>, spatial_info: field::FieldSample)
  interfaces_changed(obj: Ref<query::QueryableObjectRef>, interfaces: Vec<query::QueriedInterface>)
  moved(obj: Ref<query::QueryableObjectRef>, spatial_info: field::FieldSample)
  left(obj: Ref<query::QueryableObjectRef>)
}

/// main spatial query service
interface SpatialQueryInterface {
  beam_query(query: BeamQuery) -> (guard: Result<Ref<SpatialQueryGuard>, QueryError>)
  zone_query(query: ZoneQuery) -> (guard: Result<Ref<SpatialQueryGuard>, QueryError>)
  points_query(query: PointsQuery) -> (handle: Result<Ref<PointsQueryHandle>, QueryError>)
}

/// Error potentially returned when registering a query
enum QueryError {
    /// Invalid Refs for objects owned by the server
    InvalidRef,
	/// Querying requires at least one required interface
    NoRequiredInterfaces,
}

/// Point for a PointsQuery
struct Point {
  point: types::Vec3f,
  // the distance from a field to match in meters
  margin: f32,
}
/// handle to a points query
interface PointsQueryHandle {
  update_points(points: Vec<Point>)
}
/// guard for spatial queries
interface SpatialQueryGuard {}
