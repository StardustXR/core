import "org.stardustxr.Spatial" as spatial
import "org.stardustxr.Field" as field
import "org.stardustxr.Types" as types
import "org.stardustxr.Query" as query


/// shoot a beam and return everything it hit
struct BeamQuery {
  handler: Ref<BeamQueryHandler>,
  interfaces: Vec<query::InterfaceDependency>,

  reference_spatial: Ref<spatial::SpatialRef>,
  origin: types::Vec3f,
  direction: types::Vec3f,
  /// Maximum length of the beam in meters, can be the max f32 value
  max_length: f32,
}

/// handle the beam query
interface BeamQueryHandler {
  intersected(obj: query::QueryableId, field: Ref<field::FieldRef>, spatial: Ref<spatial::SpatialRef>, interfaces: Vec<query::QueriedInterface>, spatial_info: field::RayMarchResult)
  interfaces_changed(obj: query::QueryableId, interfaces: Vec<query::QueriedInterface>)
  moved(obj: query::QueryableId, spatial_info: field::RayMarchResult)
  /// stop caring about this object: it left the beam, or it was destroyed
  left(obj: query::QueryableId)
}

/// retarget a live beam query without re-entering everything it already hit
///
/// this node is the query's lifetime: drop it to stop querying.
///
/// only the data is editable — `reference_spatial` is fixed for the query's life, so to
/// aim the beam somewhere else, move that spatial. Dropping this handle just gives up the
/// ability to edit; the query lives as long as its handler does.
interface BeamQueryHandle {
  update(origin: types::Vec3f, direction: types::Vec3f, max_length: f32)
}

/// Get interfaces intersecting this field
struct ZoneQuery {
  handler: Ref<ZoneQueryHandler>,
  interfaces: Vec<query::InterfaceDependency>,

  zone_field: Ref<field::FieldRef>,
  margin: f32,
}

/// handle the zone query
interface ZoneQueryHandler {
  entered(obj: query::QueryableId, field: Ref<field::FieldRef>, spatial: Ref<spatial::SpatialRef>, interfaces: Vec<query::QueriedInterface>, relative_position: types::Vec3f, spatial_info: field::FieldSample)
  interfaces_changed(obj: query::QueryableId, interfaces: Vec<query::QueriedInterface>)
  moved(obj: query::QueryableId, relative_position: types::Vec3f, spatial_info: field::FieldSample)
  /// stop caring about this object: it left the zone, or it was destroyed
  left(obj: query::QueryableId)
}

/// resize a live zone query
///
/// this node is the query's lifetime: drop it to stop querying.
///
/// `zone_field` is fixed for the query's life — reshape or move that field to change what
/// the zone covers, both of which re-run the query on their own.
interface ZoneQueryHandle {
  update(margin: f32)
}

/// Get interfaces of fields containing any points
struct PointsQuery {
  handler: Ref<PointsQueryHandler>,
  interfaces: Vec<query::InterfaceDependency>,
  reference_spatial: Ref<spatial::SpatialRef>,
  points: Vec<Point>
}

/// handle the points query
interface PointsQueryHandler {
  entered(obj: query::QueryableId, field: Ref<field::FieldRef>, spatial: Ref<spatial::SpatialRef>, interfaces: Vec<query::QueriedInterface>, spatial_info: field::FieldSample)
  interfaces_changed(obj: query::QueryableId, interfaces: Vec<query::QueriedInterface>)
  moved(obj: query::QueryableId, spatial_info: field::FieldSample)
  /// stop caring about this object: no point is in range of it any more, or it was destroyed
  left(obj: query::QueryableId)
}

/// move the points of a live query
///
/// this node is the query's lifetime: drop it to stop querying.
///
/// the one set of query parameters no spatial can express: each point carries its own
/// margin and they move relative to each other, so hand them over per frame.
/// `reference_spatial` they're relative to is fixed for the query's life.
interface PointsQueryHandle {
  update(points: Vec<Point>)
}

/// main spatial query service
///
/// every query lives exactly as long as the `handler` node passed in with it. The handle
/// each of these returns edits the query's data; it owns nothing, so dropping it leaves
/// the query running.
interface SpatialQueryInterface {
  beam_query(query: BeamQuery) -> (handle: Result<Ref<BeamQueryHandle>, QueryError>)
  zone_query(query: ZoneQuery) -> (handle: Result<Ref<ZoneQueryHandle>, QueryError>)
  points_query(query: PointsQuery) -> (handle: Result<Ref<PointsQueryHandle>, QueryError>)
}

/// Error potentially returned when registering a query
enum QueryError {
    /// Invalid Refs for objects owned by the server
    InvalidRef,
	/// Querying requires at least one required interface
    NoRequiredInterfaces,
}

/// Point for a PointsQuery
struct Point {
  point: types::Vec3f,
  // the distance from a field to match in meters
  margin: f32,
}
