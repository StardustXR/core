import "org.stardustxr.Types" as types

/// Transform
struct Transform {
    translation: types::Vec3f,
    rotation: types::Quatf,
    scale: types::Vec3f,
}

/// Transform
struct PartialTransform {
    translation: Option<types::Vec3f>,
    rotation: Option<types::Quatf>,
    scale: Option<types::Vec3f>,
}

/// Bounding box
struct BoundingBox {
    center: types::Vec3f,
    extents: types::Vec3f,
}

/// A reference to a node with spatial attributes (position, rotation, scale).
/// Equivalent to a Transform in Unity, Spatial in Godot, etc.
interface SpatialRef {}

/// Spatial object
interface Spatial {
	/// Get the spatial ref for this spatial object.
	spatial_ref() -> (spatial: Ref<SpatialRef>)

	/// Get the bounding box of this spatial and its children relative to itself
	get_local_bounding_box() -> (bounding_box: BoundingBox)
	/// Get the bounding box of this spatial and its children relative to another spatial.
	get_relative_bounding_box(relative_to: Ref<SpatialRef>) -> (bounding_box: Result<BoundingBox, types::CreateError>)

	// /// Get the local transform of this spatial object.
	// get_local_transform() -> (transform: Transform)
	/// Get the transform of this spatial object.
	get_relative_transform(relative_to: Ref<SpatialRef>) -> (transform: Result<Transform, types::CreateError>)

	/// Sets the parent of this spatial object, keeping the local transform.
	/// It will silently error and not set the spatial parent if it is to a child of itself.
	set_parent(parent: Ref<SpatialRef>)
	/// Sets the parent of this spatial object, keeping its position in space.
	/// It will silently error and not set the spatial parent if it is to a child of itself.
	set_parent_in_place(parent: Ref<SpatialRef>)

	/// Set the transform of this spatial relative to its spatial parent.
	set_local_transform(transform: PartialTransform)
	/// Set the transform of this spatial relative to another spatial.
	set_relative_transform(relative_to: Ref<SpatialRef>, transform: PartialTransform)
}

/// Root interface for spatial operations.
interface SpatialInterface {
	/// Create a new spatial object.
	create_spatial(parent: Ref<SpatialRef>, transform: Transform) -> (spatial: Result<CreatedSpatial, types::CreateError>)

	/// Get the relative bounding box of a spatial object relative to another spatial.
	get_relative_bounding_box(relative_to: Ref<SpatialRef>, spatial: Ref<SpatialRef>) -> (bounding_box: Result<BoundingBox, SpatialRefOpError>)

	/// Get the relative transform of a spatial object relative to another spatial.
	get_relative_transform(relative_to: Ref<SpatialRef>, spatial: Ref<SpatialRef>) -> (transform: Result<Transform, SpatialRefOpError>)
}

/// Struct returned by SpatialInterface::create_spatial so it can have proper errors
struct CreatedSpatial {
    spatial: Ref<Spatial>, 
    spatial_ref: Ref<SpatialRef>
}
/// Error returned when getting information from a SpatialRef
enum SpatialRefOpError {
    /// The SpatialRef passed to relative_to is invalid
    RelativeToInvalid,
    /// The SpatialRef passed to spatial is invalid
	SpatialRefInvalid,
}
